{
  "name": "angular-heroes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "json-server --watch db.json --port 3000"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
